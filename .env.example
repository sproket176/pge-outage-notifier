# Locality: 7-digit TERYT SIMC code of your town/village. Find it on the PGE outage map
# (https://power-outage.gkpge.pl): search for your address and read citySym from the
# request the page makes, or look it up in the TERYT SIMC register.
PGE_CITY_SYM=
PGE_BASE_URL=https://power-outage.gkpge.pl
PGE_POLL_INTERVAL_MINUTES=30
# Consecutive failed fetches before a "cannot reach PGE" notification is sent
PGE_FAILURE_ALERT_THRESHOLD=6

# Reminders for planned outages: the evening before and shortly before the start
REMINDER_INTERVAL_MINUTES=5
REMINDER_EVENING_HOUR=18
REMINDER_SHORTLY_BEFORE_MINUTES=60

# Yearly interruption allowances in hours; exceeding one entitles to a rebate.
# Empty = allowance not set, hours are still summed.
PLANNED_OUTAGE_ALLOWANCE_HOURS=35
UNPLANNED_OUTAGE_ALLOWANCE_HOURS=

# ntfy.sh: the topic is the only secret, generate a long random one, e.g. `openssl rand -hex 16`
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Only for a self-hosted ntfy server or a paid ntfy.sh account
NTFY_TOKEN=

# State and logging (Docker overrides DB_PATH with /data/outages.db)
DB_PATH=data/outages.db
TZ=Europe/Warsaw
LOG_LEVEL=INFO
